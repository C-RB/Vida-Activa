# ─────────────────────────────────────────────────────────────────────────────
# Variables de la APLICACIÓN (backend + base de datos)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=activamente
POSTGRES_PASSWORD=change_me
POSTGRES_DB=activamente_db
# El host es "db" (nombre del servicio en docker-compose), no localhost.
DATABASE_URL=postgresql://activamente:change_me@db:5432/activamente_db

SECRET_KEY=cambia_esto_por_un_secreto_largo_y_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# Variables de DESPLIEGUE
# ─────────────────────────────────────────────────────────────────────────────
# VPS_HOST=203.0.113.10               # IP o dominio de la VPS
# VPS_USER=deploy                     # usuario SSH de la VPS
# VPS_PASSWORD=tu_contraseña_ssh      # contraseña SSH (Masked)
