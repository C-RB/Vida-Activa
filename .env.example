# Application variables (backend + database)
POSTGRES_USER=vida_activa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vida_activa_db
# The host is "db" (the docker-compose service name), not localhost.
DATABASE_URL=postgresql://vida_activa:change_me@db:5432/vida_activa_db

SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
